/* =====================================================================
   FILE CẤU HÌNH DUY NHẤT — tất cả room, phòng, mũi tên chỉ đường.

   editMode: false  -> mở GUI chỉnh sửa (thêm / kéo / xoay 3D mũi tên)
   editMode: false -> đóng GUI, chỉ xem

   - rooms có 1 phần tử  -> vào thẳng, không hiện trang chủ
   - rooms có 2+ phần tử -> hiện trang chủ để chọn room
   - scene.parent = id phòng cha (null = cấp cao nhất)

   Mỗi mũi tên (hotspot) trong "hotspots":
     to     : id phòng sẽ đi tới
     yaw    : hướng ngang tới vị trí mũi tên (độ)
     pitch  : hướng dọc tới vị trí mũi tên (âm = dưới chân trời)
     dist   : khoảng cách tới mũi tên (bỏ trống = nằm đúng trên sàn)
     rotX   : xoay quanh trục X (độ) — nghiêng lên/xuống
     rotY   : xoay quanh trục Y (độ) — quay hướng trên sàn
     rotZ   : xoay quanh trục Z (độ) — nghiêng sang bên / lật
     scale  : to/nhỏ (mặc định 1)
     label  : tên hiển thị phía trên mũi tên (bỏ trống = tên phòng)
     image  : ảnh mũi tên riêng cho cái này (bỏ trống = arrow.image bên dưới)

   -> Không cần gõ tay: dùng GUI chỉnh sửa rồi chọn
      ① Ghi tự động vào config.js (chạy: node serve.js)
      ② Copy mũi tên / copy cả phòng rồi dán vào "hotspots"
   ===================================================================== */
const TOUR_CONFIG = {

  editMode: true,   // ✏️ true = mở chỉnh sửa | false = đóng

  // Ảnh mũi tên chỉ đường (dùng chung, có thể ghi đè từng mũi tên bằng "image")

  arrow: {
    image: "images/skin/muiten.png",
    sprite: { cols: 5, rows: 5, frames: 25, fps: 15 },
    tipY: 0.47,
